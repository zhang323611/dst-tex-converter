<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.DstTex.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/title_settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_convert_mode"
                android:textAppearance="?attr/textAppearanceSubtitle1" />

            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/modeAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_auto" />

                <RadioButton
                    android:id="@+id/modePng2Tex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_png2tex" />

                <RadioButton
                    android:id="@+id/modeTex2Png"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_tex2png" />

                <RadioButton
                    android:id="@+id/modeDxt2Astc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_dxt2astc" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/pref_quality"
                android:textAppearance="?attr/textAppearanceSubtitle1" />

            <RadioGroup
                android:id="@+id/rgQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/qFast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quality_fast" />

                <RadioButton
                    android:id="@+id/qMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quality_medium" />

                <RadioButton
                    android:id="@+id/qThorough"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quality_thorough" />

                <RadioButton
                    android:id="@+id/qExhaustive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quality_exhaustive" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/pref_block_info"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/text_caption" />

            <CheckBox
                android:id="@+id/cbBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:minHeight="@dimen/touch_min"
                android:text="@string/pref_backup" />

            <CheckBox
                android:id="@+id/cbNested"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="@string/pref_nested" />

            <CheckBox
                android:id="@+id/cbDebug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="@string/pref_debug" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/pref_threads"
                android:textAppearance="?attr/textAppearanceSubtitle1" />

            <RadioGroup
                android:id="@+id/rgThreads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/t1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/threads_single" />

                <RadioButton
                    android:id="@+id/t2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/threads_2" />

                <RadioButton
                    android:id="@+id/t4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/threads_4" />

                <RadioButton
                    android:id="@+id/t8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/threads_8" />

                <RadioButton
                    android:id="@+id/tAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </RadioGroup>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
